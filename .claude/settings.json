{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 120,
            "statusMessage": "Catching up: health report, HANDOFF, git…"
          }
        ]
      }
    ]
  }
}
